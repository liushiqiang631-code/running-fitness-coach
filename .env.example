# Reference only: the application does not automatically load .env files.
# Keep actual keys in your local environment. Never commit real values.
RUNNING_COACH_ENABLE_EXTERNAL_API=0
SILICONFLOW_API_KEY=
HOST=127.0.0.1
PORT=3000
RAG_PORT=8008
RAG_BASE_URL=http://127.0.0.1:8008
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=running_coach_demo
# Optional paths. Relative values resolve against the YAML config directory.
RUNNING_COACH_CONFIG=
RUNNING_COACH_JSON_DIR=
RUNNING_COACH_IMAGES_DIR=
RUNNING_COACH_CACHE_DIR=
RUNNING_COACH_BM25_DIR=
RUNNING_COACH_EVAL_DIR=
